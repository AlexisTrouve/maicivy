<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
    ============================================================================
    DevDependencies Suppressions
    ============================================================================
    These vulnerabilities are in development dependencies only and do not affect
    the production build or runtime security.
    -->

    <!-- MSW (Mock Service Worker) - Testing library only -->
    <suppress>
        <notes><![CDATA[
        msw is a development dependency used for API mocking in tests.
        The cookie vulnerability (GHSA-pxg6-pf52-xh8x) does not affect production.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/msw@.*$</packageUrl>
        <cve>GHSA-pxg6-pf52-xh8x</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
        cookie is a transitive dependency through msw (dev only).
        Does not affect production builds.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/cookie@.*$</packageUrl>
        <cve>GHSA-pxg6-pf52-xh8x</cve>
    </suppress>

    <!-- ts-node and diff - Build tools only -->
    <suppress>
        <notes><![CDATA[
        ts-node is used for TypeScript execution during development only.
        The diff vulnerability (GHSA-73rr-hh4g-fpgx) does not affect production.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/ts-node@.*$</packageUrl>
        <cve>GHSA-73rr-hh4g-fpgx</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
        diff is a transitive dependency through ts-node (dev only).
        Does not affect production builds.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/diff@.*$</packageUrl>
        <cve>GHSA-73rr-hh4g-fpgx</cve>
    </suppress>

    <!-- Jest - Testing framework only -->
    <suppress>
        <notes><![CDATA[
        jest and related packages are testing frameworks used during development only.
        Does not affect production builds.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/jest(-.*)?@.*$</packageUrl>
        <cve>GHSA-73rr-hh4g-fpgx</cve>
    </suppress>

    <!-- undici - Pinned version 5.28.0 for compatibility -->
    <suppress until="2026-03-01Z">
        <notes><![CDATA[
        undici 5.28.0 is intentionally pinned for Next.js compatibility.
        The vulnerabilities are low severity and will be addressed when upgrading Next.js.
        This suppression expires on 2026-03-01 to force a re-evaluation.
        ]]></notes>
        <packageUrl regex="true">^pkg:npm/undici@5\.28\.0$</packageUrl>
        <cve>GHSA-3787-6prv-h9w3</cve>
        <cve>GHSA-c76h-2ccp-4975</cve>
        <cve>GHSA-cxrh-j4jr-qwg3</cve>
        <cve>GHSA-9qxr-qj54-h672</cve>
        <cve>GHSA-m4v8-wqvr-p9f7</cve>
        <cve>GHSA-g9mf-h72j-4rw9</cve>
    </suppress>

</suppressions>
