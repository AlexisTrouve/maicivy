# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development

# CORS Configuration (Middlewares Phase 1)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=maicivy
DB_PASSWORD=your_secure_password
DB_NAME=maicivy
DB_SSL_MODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# AI Services (Phase 3 - Required for letters)
# ============================================
# Clé de la passerelle Etheryale (ANTHROPIC_BASE_URL). SEULE route vers un modèle : la passerelle
# expose plusieurs fournisseurs derrière le protocole Anthropic. Requise.
ANTHROPIC_API_KEY=sk-ant-

# Modèle de repli si le modèle demandé échoue — atteint par la MÊME passerelle, donc aucune clé
# supplémentaire n'est nécessaire. Vide = pas de repli (échec franc).
AI_FALLBACK_MODEL=gpt-5.6-terra

# ============================================
# Profile Enrichment (Phase 1 & 13)
# ============================================
# Clearbit API key: https://clearbit.com/
# Optional - Used for company profile enrichment and visitor detection
# Free tier available at https://clearbit.com/api-docs
CLEARBIT_API_KEY=

# ============================================
# GitHub OAuth (Phase 5 - Advanced Features)
# ============================================
# GitHub OAuth Application: https://github.com/settings/developers
# Required for GitHub repository import feature
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# GitHub API Token (optional, for higher rate limits)
# Personal access token: https://github.com/settings/tokens
# Optional - Used for GitHub import with higher API limits
GITHUB_API_TOKEN=
